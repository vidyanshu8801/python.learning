#question 13: waf power(base,exp) that return base raised to exp using a loop- no**operator or pow() allowed.
def power(base, exp):
    result = 1
    for _ in range(abs(exp)):
        result *= base
    return 1 / result if exp < 0 else result
print(power(3,2))

#question 14: waf tax_calculator(income)that takes annual income and returns the tax amount based on these slabs:
#up to 250000 - no tax 
#250001 to 500000 - 5%
#500001 to 1000000 -10%
#above 1000000-30%

def tax_calculator(income):
    if income <= 250000:
        return "No tax"
    elif income >= 250001 and income <= 500000:
        return income * 0.05
    elif income >= 500001 and income <= 1000000:
        return income * 0.2
    return income * 0.3

